{
  "description": "PAX — Claude Code를 열 때 회사·개인 스킬 동기화, pax-* 관리 스킬 편집 보호",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/vibeagent-sync-skills.mjs\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/vibeagent-skill-guard-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
